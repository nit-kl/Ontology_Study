PREFIX bot: <https://w3id.org/bot#>
PREFIX brick: <https://brickschema.org/schema/1.4/Brick#>
PREFIX cpr: <http://example.org/ontology/cp-retail#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX unit: <http://qudt.org/vocab/unit/>

SELECT ?label ?storeCode ?address ?hours ?opened ?org ?parent ?area ?floor ?system
WHERE {
  ?store a bot:Building ;
         cpr:storeCode ?storeCode ;
         rdfs:label ?label ;
         schema:address ?address ;
         schema:openingHours ?hours ;
         schema:foundingDate ?opened ;
         schema:containedInPlace ?areaNode ;
         cpr:operatedBy ?orgNode ;
         cpr:grossFloorArea ?areaQuantity .
  FILTER(?storeCode = "{{STORE_CODE}}")
  FILTER(lang(?label) = "ja")
  ?areaQuantity qudt:numericValue ?floor ;
                qudt:unit unit:M2 .
  ?areaNode rdfs:label ?area . FILTER(lang(?area) = "ja")
  ?orgNode rdfs:label ?org . FILTER(lang(?org) = "ja")
  ?orgNode schema:parentOrganization ?parentNode .
  ?parentNode rdfs:label ?parent . FILTER(lang(?parent) = "ja")
  ?systemNode a brick:HVAC_System ;
              rdfs:label ?system .
  FILTER(lang(?system) = "ja")
}
