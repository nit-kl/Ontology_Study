PREFIX brick: <https://brickschema.org/schema/1.4/Brick#>
PREFIX cpr: <http://example.org/ontology/cp-retail#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX unit: <http://qudt.org/vocab/unit/>

SELECT ?equipCode ?equipLabel ?capacity ?oaCode ?powerCode ?energyCode
WHERE {
  ?equip a brick:Heat_Pump ;
         cpr:equipmentCode ?equipCode ;
         rdfs:label ?equipLabel ;
         cpr:ratedCoolingPower ?power .
  FILTER(lang(?equipLabel) = "ja")
  ?power qudt:numericValue ?capacity ;
         qudt:unit unit:KiloW .
  ?oa a brick:Outside_Air_Temperature_Sensor ;
      brick:timeseries ?oaSeries .
  ?oaSeries brick:hasTimeseriesId ?oaCode .
  ?kw a brick:Electric_Power_Sensor ;
      brick:isPointOf ?equip ;
      brick:timeseries ?kwSeries .
  ?kwSeries brick:hasTimeseriesId ?powerCode .
  ?kwh a brick:Electric_Energy_Sensor ;
       brick:isPointOf ?equip ;
       brick:timeseries ?kwhSeries .
  ?kwhSeries brick:hasTimeseriesId ?energyCode .
}
