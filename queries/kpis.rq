PREFIX cpr: <http://example.org/ontology/cp-retail#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?label ?formula
WHERE {
  ?store a cpr:RetailBuilding ;
         cpr:storeCode "{{STORE_CODE}}" ;
         cpr:definesKpi ?kpi .
  ?kpi rdfs:label ?label ;
       cpr:kpiFormulaText ?formula .
  FILTER(lang(?label) = "ja")
  FILTER(lang(?formula) = "ja")
}
ORDER BY ?label
